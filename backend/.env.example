# Campaign Mailer — backend environment
#
# Copy to backend/.env and fill in. Never commit the filled file.
# The process refuses to start when a required variable is missing, so a
# misconfigured deployment fails at boot instead of on the first request that
# needs the value. See backend/src/config/env.ts.
#
# The "needed from" column says which roadmap phase first reads the variable.
# Anything marked Phase 0 is required to boot today.


# ---------------------------------------------------------------------------
# Runtime — Phase 0
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. Railway sets this itself in production.
PORT=3000

# Proxies in front of the API whose X-Forwarded-For entries are trusted.
# 1 behind Railway alone (the default); 2 in production, where Vercel relays
# /api to Railway. Too low and every anonymous visitor shares the proxy's
# address in the rate limit; too high and a client can forge its own.
TRUST_PROXY_HOPS=1

# Origin of the web app. CORS is restricted to it, and OAuth redirects back
# through it. No trailing slash.
FRONTEND_URL=http://localhost:5173


# ---------------------------------------------------------------------------
# Database — Phase 0
# ---------------------------------------------------------------------------

# Neon Postgres, from the project dashboard > Connect.
#
# Two strings, and the difference is one word in the host. The pooled host
# carries "-pooler" and serves the API and the worker, which open connections
# from separate processes. The direct host has no "-pooler" and is used only by
# migrations, because the pooler does not support the session-level statements
# a migration runs.
#
# Copy both from the console rather than editing one into the other by hand:
# the host also carries a proxy segment (c-NN) that differs per project.
#
# Then change sslmode=require to sslmode=verify-full on both. node-postgres
# warns that `require` will adopt libpq semantics in pg 9, where it encrypts
# without verifying the server certificate. Naming verify-full pins the
# verification instead of inheriting whatever the default becomes, and Neon
# serves a certificate that passes it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.c-NN.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full

DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.c-NN.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full


# ---------------------------------------------------------------------------
# Queue — Phase 4 (the session store reads it from Phase 1)
# ---------------------------------------------------------------------------

# Upstash Redis, the rediss:// URI from the database page.
# BullMQ needs a plain Redis connection, not the REST API.
REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:6379


# ---------------------------------------------------------------------------
# Sessions and encryption — Phase 1
# ---------------------------------------------------------------------------

# Signs the session cookie. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM key protecting the Google tokens at rest. Exactly 32 bytes, hex
# encoded, so 64 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing this key makes every stored token undecryptable and forces every user
# to reconnect their Google account. Keep it in the secret manager, not only
# in this file.
ENCRYPTION_KEY=

# Only during a key rotation: the retired key(s), comma separated. They decrypt
# stored tokens and never encrypt. Remove them once
# `npm run rotate:encryption-key --workspace backend` has run.
# Procedure: docs/security.md.
ENCRYPTION_KEY_PREVIOUS=


# ---------------------------------------------------------------------------
# Google OAuth and Gmail — Phase 1
# ---------------------------------------------------------------------------

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID,
# type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an authorized redirect URI on that client, character for
# character. In production: https://your-domain/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Sign in with MailFind, and MailFind signing in with this application.
# MAILFIND_URL is MailFind's API origin, where its /api lives (its API_URL).
# MAILFIND_SSO_SECRET is the same value as CAMPAIGN_MAILER_SSO_SECRET on
# MailFind's side, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Either empty, and both "sign in with" buttons stay inert.
MAILFIND_URL=
MAILFIND_SSO_SECRET=


# ---------------------------------------------------------------------------
# Sending limits — Phase 4
# ---------------------------------------------------------------------------

# Hard cap per account over a rolling 24 hours, across every campaign, enforced
# by the application. Google allows a personal account 500; 450 leaves room for
# the messages the user sends by hand. The process refuses a value above 500.
#
# The pause between two sends is set per campaign (10 s minimum, 30 s by
# default), not here.
GMAIL_DAILY_LIMIT=450


# ---------------------------------------------------------------------------
# Attachment storage — Phase 3
# ---------------------------------------------------------------------------

# Cloudflare R2, which speaks S3. The endpoint is built from the account ID
# shown on the R2 overview page. R2 has no regions of its own, so the S3
# clients want the literal string "auto".
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=campaign-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The bucket stays private. Attachments are read by the backend when it builds
# a message, never fetched by a browser, so no public bucket URL is needed.


# ---------------------------------------------------------------------------
# Observability — Phase 7
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=debug

# Sentry project DSN (Settings > Client Keys). Leave empty to disable error
# reporting. The API and the worker share it; events carry a "service" tag.
# Addresses and Google tokens are redacted before an event leaves the process.
# RAILWAY_GIT_COMMIT_SHA, set by Railway, becomes the release.
SENTRY_DSN=

# Alerts (worker stopped, queue stuck) checked by the API every five minutes,
# about 35 000 Redis commands a month. Defaults to true in production and false
# elsewhere, where the worker usually is not running. The send error rate alert
# runs in the worker and needs no setting. Run it on one API instance only.
WORKER_MONITOR=
